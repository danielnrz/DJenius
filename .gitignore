# DJenius .gitignore

# Music and audio files - NEVER commit these
testMusic/
*.mp3
*.wav
*.flac
*.m4a
*.aac
*.ogg
*.wma
*.aiff

# Generated outputs
output/
outputs/
mixes/
stems/
edits/
remixes/

# Analysis cache and database
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.eggs/

# Virtual environment
.venv/
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Models and weights
models/
*.pt
*.pth
*.onnx
*.bin
*.safetensors
*.pkl

# Temporary files
tmp/
temp/
*.tmp
*.log

# Large runtime artifacts
*.pickle
cache/
.caches/

# Secrets
.env
.env.*
*.key
*.pem
